{
  "name": "adaptive-model-routing-usage",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["15 * * * *"] },
  "d1_databases": [{
    "binding": "COUNTS",
    "database_name": "adaptive-model-routing-usage",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "vars": {
    "PACKAGE_VERSIONS": "0.3.0",
    "POSTHOG_INGEST_HOST": "https://eu.i.posthog.com"
  }
}
